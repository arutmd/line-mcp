{
  "name": "line-mcp",
  "version": "0.1.0",
  "description": "LINE MCP: Desktop AI companion for LINE - extract tasks, gate AI posting per group, and connect via MCP",
  "main": "dist/cli.js",
  "bin": {
    "line-mcp": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli.ts",
    "mcp": "tsx src/mcp/server.ts",
    "dashboard": "tsx src/server.ts",
    "test": "tsx test/e2e.ts",
    "dev": "tsx watch src/cli.ts"
  },
  "keywords": [
    "line",
    "mcp",
    "ai",
    "task-extractor",
    "claude",
    "codex"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "openai": "^4.86.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arutmd/line-mcp.git"
  },
  "engines": {
    "node": ">=22"
  }
}
